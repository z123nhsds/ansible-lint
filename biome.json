{
  "$schema": "https://biomejs.dev/schemas/latest/schema.json",
  "assist": {
    "actions": {
      "source": {
        "useSortedKeys": "on"
      }
    }
  },
  "files": {
    "includes": [
      "**/*.js",
      "**/*.jsx",
      "**/*.ts",
      "**/*.tsx",
      "**/*.cjs",
      "**/*.mjs",
      "**/*.cts",
      "**/*.mts",
      "**/*.d.ts",
      "**/*.d.cts",
      "**/*.d.mts",
      "**/*.json",
      "**/*.jsonc",
      "**/*.css",
      "**/*.graphql",
      "**/*.gql",
      "**/*.svelte",
      "**/*.vue",
      "**/*.astro",
      "!src/ansiblelint/schemas",
      "!docs/_static/theme_overrides.css",
      "!test/schemas/negative_test",
      "!examples/**/pattern.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "json": {
    "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2,
      "lineWidth": 80
    }
  },
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  }
}
