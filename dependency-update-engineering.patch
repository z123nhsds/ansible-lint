+# =============================================================================
+# ReadTheDocs 配置文件
+# =============================================================================
+#
+# 文档自动重建机制：
+#
+#   触发条件：
+#     ReadTheDocs 通过 GitHub Webhook 监听 main 分支的 push 事件。
+#     每当有 commit 推送到 main 分支（包括 Renovate PR 合并），RTD 自动触发构建。
+#
+#   完整流程：
+#     ┌────────────────────────────────────────────────────────────────┐
+#     │ Renovate PR 合并到 main                                         │
+#     │   │                                                            │
+#     │   ├── GitHub push event → ReadTheDocs webhook 收到通知          │
+#     │   │                                                            │
+#     │   ├── RTD 读取 .readthedocs.yml 配置                            │
+#     │   │   ├── version: 2                                           │
+#     │   │   ├── build.os: ubuntu-24.04                               │
+#     │   │   ├── build.tools.python: "3.13"  ← Renovate 可自动更新     │
+#     │   │   └── mkdocs.fail_on_warning: true                         │
+#     │   │                                                            │
+#     │   ├── RTD 执行 build.commands（按顺序）：                        │
+#     │   │   ├── curl mise.run | sh        → 安装 mise 版本管理器      │
+#     │   │   ├── mise settings ...         → 配置 mise（实验特性+编译） │
+#     │   │   ├── mise trust                → 信任项目配置              │
+#     │   │   ├── mise install              → 安装 mise.toml 中声明的   │
+#     │   │   │                                Python 版本（与本地一致）  │
+#     │   │   ├── mise exec -- tox -e docs  → 在 mise 管理的 Python     │
+#     │   │   │                               环境中运行文档构建         │
+#     │   │   └── mkdocs build              → 生成静态 HTML 站点        │
+#     │   │                                                            │
+#     │   └── RTD 部署 → https://docs.ansible.com/projects/lint/       │
+#     └────────────────────────────────────────────────────────────────┘
+#
+#   依赖更新联动：
+#     - Renovate 更新 pyproject.toml 中的 docs 依赖组（mkdocs-ansible 等）
+#       → 合并后 RTD 自动重建，使用新版文档工具链
+#     - Renovate 通过 customManagers regex 更新 build.tools.python 版本
+#       → 与 mise.toml 保持同步
+#     - Renovate 更新 mise.toml 中的 Python 版本
+#       → RTD 构建时 `mise install` 自动拉取新版 Python
+#
+#   可追溯性：
+#     - RTD Build Dashboard: https://readthedocs.org/projects/ansible-lint/builds/
+#     - 每次构建有独立 URL、日志、状态
+#     - GitHub commit SHA 与 RTD build ID 一一对应
+# =============================================================================
+
 version: 2
 
 mkdocs:
-  fail_on_warning: true
-  configuration: mkdocs.yml
+  fail_on_warning: true                # 任何 mkdocs 警告都会导致构建失败
+  configuration: mkdocs.yml            # mkdocs 配置文件路径
 
 build:
-  os: ubuntu-24.04
+  os: ubuntu-24.04                     # 固定构建 OS 版本，保证可复现
   tools:
-    python: "3.13"
+    python: "3.13"                     # Renovate 通过 customManagers regex 自动更新
+  jobs:
+    post_checkout:
+      - git fetch --unshallow || true   # 确保 setuptools_scm 能正确推断版本号
   commands:
+    # Step 1: 安装 mise（版本管理器，与本地开发环境一致）
     - curl https://mise.run | sh
+    # Step 2: 配置 mise
+    #   experimental=true   — 启用 uv_venv_auto 等实验特性
+    #   python.compile=false — 使用预编译 Python，加速 RTD 构建
+    #   python.uv_venv_auto=true — 自动使用 uv 管理虚拟环境
     - ~/.local/bin/mise settings experimental=true
     - ~/.local/bin/mise settings python.compile=false
     - ~/.local/bin/mise settings python.uv_venv_auto=true
+    # Step 3: 信任项目 mise.toml 配置
     - ~/.local/bin/mise trust
+    # Step 4: 安装 mise.toml 中声明的 Python 版本
+    #   这一步保证 RTD 使用的 Python 版本与本地开发环境和 CI 完全一致
     - ~/.local/bin/mise install
+    # Step 5: 诊断 mise 环境（输出 Python 版本、PATH 等信息，便于排查问题）
     - PATH=~/.local/share/mise/shims:$PATH ~/.local/bin/mise doctor || true
+    # Step 6: 在 mise 管理的 Python 环境中安装 tox（文档构建编排工具）
     - PATH=~/.local/share/mise/shims:$PATH ~/.local/bin/mise exec --command "python3 -m pip install tox"
+    # Step 7: 运行 tox docs 环境（安装 pyproject.toml [dependency-groups].docs 中的依赖并构建文档）
     - PATH=~/.local/share/mise/shims:$PATH ~/.local/bin/mise exec --command "python3 -m tox -e docs"
+
 submodules:
-  include: all
-  recursive: true
+  include: all                         # 包含所有 git submodules
+  recursive: true                      # 递归初始化子模块的嵌套子模块
+
+# =============================================================================
+# 环境一致性保证
+# =============================================================================
+#
+#   维度            │ 本地开发          │ tox.yml CI         │ ReadTheDocs
+#   ────────────────┼──────────────────┼────────────────────┼──────────────────
+#   Python 版本管理 │ mise.toml        │ default_python     │ build.tools.python
+#                   │ python = "3.13"   │ "3.13"             │ "3.13"
+#   ────────────────┼──────────────────┼────────────────────┼──────────────────
+#   版本更新方式    │ Renovate 自动PR  │ 随 mise.toml 更新  │ Renovate regex
+#                   │ (mise manager)   │ (手动或Renovate)   │ (customManagers)
+#   ────────────────┼──────────────────┼────────────────────┼──────────────────
+#   依赖安装        │ uv sync          │ tox -e docs        │ mise exec -- tox -e docs
+#                   │ (pyproject.toml) │ (pyproject.toml)   │ (pyproject.toml)
+#   ────────────────┼──────────────────┼────────────────────┼──────────────────
+#
+#   三者使用完全相同的 Python 版本、完全相同的 pyproject.toml 依赖声明，
+#   确保从本地开发 → CI 验证 → 文档发布的整个链路环境一致、结果可复现。
diff --git a/mise.toml b/mise.toml
