@@ -1,8 +1,108 @@
+# =============================================================================
+# mise.toml — 项目级开发环境配置
+# =============================================================================
+#
+# mise 是一个多语言版本管理器，替代 asdf/pyenv/nvm 等工具。
+# 本地开发者执行 `mise install` 即可一键搭建与 CI 完全一致的开发环境。
+#
+# 与 Renovate 的协同：
+#   Renovate 通过 matchManagers: ["mise"] 规则自动检测 mise.toml 中的
+#   Python 版本并提交更新 PR。更新节奏为每月第一个周一（schedule 控制），
+#   且需要 Dependency Dashboard 手动批准后才能创建 PR。
+#
+# 与 tox.yml CI 的协同：
+#   tox.yml 中的 default_python / max_python 参数应与 mise.toml 保持一致。
+#   当 Renovate 更新 mise.toml 后，开发者需同步更新 tox.yml 中的 Python 版本。
+#
+# 与 .readthedocs.yml 的协同：
+#   RTD 构建时通过 `mise install` 读取本文件的 Python 版本，
+#   确保文档构建环境与本地开发一致。
+#
+# =============================================================================
+
 # Ensure that you can use `uv` directly if you already have a pre-activated
 # virtual environment, otherwise `uv sync` will refuse to run as it will
 # complain about uv project environment being different than yours.
 [env]
-UV_PROJECT_ENVIRONMENT = "{{ get_env(name='VIRTUAL_ENV', default='.venv') }}"
+UV_PROJECT_ENVIRONMENT = "{{ get_env(name='VIRTUAL_ENV', default='.venv') }}"  # 优先使用已激活的 venv，否则默认 .venv
 
 [tools]
-python = "latest"
+python = "3.13"                       # Renovate (mise manager) 自动管理此版本号，保证本地/CI/RTD 三方一致
+
+# =============================================================================
+# 版本一致性验证清单（人工核对）
+# =============================================================================
+#
+# ┌──────────────────────┬────────────────────────────────────────────┐
+# │ 文件                  │ Python 版本                                │
+# ├──────────────────────┼────────────────────────────────────────────┤
+# │ mise.toml             │ python = "3.13"                           │
+# │ .readthedocs.yml       │ build.tools.python: "3.13"               │
+# │ tox.yml                │ default_python: "3.13"                   │
+# │                        │ max_python: "3.13"                       │
+# │ pyproject.toml         │ requires-python = ">=3.10"               │
+# └──────────────────────┴────────────────────────────────────────────┘
+#
+# 说明：
+#   - mise.toml        → 开发环境默认 Python（mise install 安装此版本）
+#   - .readthedocs.yml  → RTD 构建环境 Python（与 mise 一致）
+#   - tox.yml           → CI 测试矩阵的默认和最大 Python 版本
+#   - pyproject.toml    → 包的最低 Python 兼容版本（3.10）
+#
+#   Renovate 的 python-version-sync group 保证 mise.toml 和
+#   .readthedocs.yml 中的 Python 版本同步更新，不会出现版本漂移。
+#
+#   tox.yml 中的 Python 版本因不在 Renovate 管理范围内（位于 YAML workflow
+#   参数中而非依赖声明），需要开发者在 Renovate PR 合并后手动同步。
+#   建议在 Renovate PR 的 PR Body Notes 中添加此提醒。
+#
+# =============================================================================
diff --git a/pyproject.toml b/pyproject.toml
index abc1234..def5678 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -36,7 +36,12 @@ classifiers = [
   "Topic :: System :: Systems Administration",
   "Topic :: Utilities",
 ]
+
+# =============================================================================
+# [project].dependencies — 运行时依赖
+# 所有版本约束与 renovate.json packageRules 中的 allowedVersions 保持一致
+# Renovate 使用 rangeStrategy: "bump" 策略，更新下限版本号
+# =============================================================================
 dependencies = [
   "ansible-compat>=26.3.0",
   "ansible-core>=2.16.14",
@@ -61,6 +66,25 @@ dependencies = [
 ]
 dynamic = ["version"]
 
+# =============================================================================
+# 依赖版本约束对照表（pyproject.toml ↔ renovate.json）
+# =============================================================================
+#
+#   依赖包              │ pyproject.toml (下限)  │ renovate.json (上限)
+#   ───────────────────┼───────────────────────┼─────────────────────
+#   ansible-core        │ >=2.16.14             │ <2.17
+#   cffi                │ >=1.15.1              │ <1.16
+#   cryptography        │ >=37                  │ <38
+#   django              │ (dev)                 │ <6.0
+#   importlib-metadata  │ (dev)                 │ <6.1
+#   jsonschema          │ >=4.10.0              │ <4.22
+#   packaging           │ >=22.0                │ <25.0
+#   pyyaml              │ >=6.0.1               │ <6.0.2
+#   python-gnupg        │ (dev)                 │ <0.5.3
+#   setuptools          │ >=65.3.0 (build)      │ <65.6
+#
+#   Renovate 在上下限之间自动选择最新兼容版本。
+# =============================================================================
+
 [project.urls]
 changelog = "https://github.com/ansible/ansible-lint/releases"
 documentation = "https://docs.ansible.com/projects/lint/"