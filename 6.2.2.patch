diff --git a/.pre-commit-hooks.yaml b/.pre-commit-hooks.yaml
index 455e7b16..9f52fc63 100644
--- a/.pre-commit-hooks.yaml
+++ b/.pre-commit-hooks.yaml
@@ -6,7 +6,7 @@
   # keep name lowercase for consistency with other hook names
   name: ansible-lint
   description: This hook runs ansible-lint.
-  entry: python3 -m ansiblelint -v --force-color
+  entry: bash -ec 'if [[ -n "${ANSIBLE_COLLECTIONS_PATH:-}" ]]; then export PYTHONPATH="${ANSIBLE_COLLECTIONS_PATH}${PYTHONPATH:+:${PYTHONPATH}}"; fi; exec python3 -m ansiblelint -v --force-color "$@"' --
   language: python
   # version is needed to avoid accidental use of python3.10 on some platforms
   # as this is not supported by recent versions of ansible-lint and ansible-core
@@ -15,10 +15,3 @@
   # https://github.com/ansible/ansible-lint/issues/611
   pass_filenames: false
   always_run: true
-  additional_dependencies:
-    # https://github.com/pre-commit/pre-commit/issues/1526
-    # If you want to use a specific version of ansible-core or ansible, feel
-    # free to override `additional_dependencies` in your own hook config
-    # file as we only support latest stable version of ansible-core when used
-    # as an action.
-    - ansible-core>=2.19.0
diff --git a/action.yml b/action.yml
index e9dddfbe..cc4e09c3 100644
--- a/action.yml
+++ b/action.yml
@@ -84,6 +84,22 @@ runs:
         echo "reqs_file=$reqs_file" >> $GITHUB_OUTPUT
         wget --output-document=$reqs_file https://raw.githubusercontent.com/ansible/ansible-lint/$GH_ACTION_REF/.config/requirements-lock.txt
 
+    - name: Prepare Ansible dependency paths
+      shell: bash
+      working-directory: ${{ steps.inputs.outputs.working_directory }}
+      run: |
+        workspace_root=$(git rev-parse --show-toplevel)
+        ansible_home="$workspace_root/.ansible"
+        collections_path="$ansible_home/collections"
+        roles_path="$ansible_home/roles"
+        mkdir -p "$collections_path" "$roles_path"
+        {
+          echo "ANSIBLE_HOME=$ansible_home"
+          echo "ANSIBLE_COLLECTIONS_PATH=$collections_path${ANSIBLE_COLLECTIONS_PATH:+:$ANSIBLE_COLLECTIONS_PATH}"
+          echo "ANSIBLE_ROLES_PATH=$roles_path${ANSIBLE_ROLES_PATH:+:$ANSIBLE_ROLES_PATH}"
+          echo "PYTHONPATH=$collections_path${PYTHONPATH:+:$PYTHONPATH}"
+        } >> "$GITHUB_ENV"
+
     - name: Set up uv
       if: inputs.setup_python == 'true'
       uses: astral-sh/setup-uv@v8.1.0
